# Docker Compose development values. Do not commit a real .env file.
POSTGRES_USER=sonora
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sonora
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_HOURS=168
SONORA_PORT=8087

# Opcionales. Habilitan Last.fm OAuth y etiquetas para recomendaciones; Sonora funciona sin ellas.
LASTFM_API_KEY=
LASTFM_API_SECRET=
# LASTFM_CALLBACK_URL=https://sonora.example.com/api/lastfm/callback

# Opcional: Uptime Kuma y Telegram (si se dejan vacíos, se auto-detectan desde Uptime Kuma)
# UPTIME_KUMA_DATA_DIR=/home/server-ale/appa/uptime-kuma/uptime-kuma-data
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
