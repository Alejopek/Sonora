YTMUSIC_AUTH=
FRONTEND_ORIGIN=http://localhost:5173
# PostgreSQL is required for accounts, playlists, history and favorites.
DATABASE_URL=postgresql://sonora:change_me@localhost:5432/sonora
# Use a long random value in every non-local environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_HOURS=168
# Opcional. Enriquece etiquetas de Last.fm en el backend; nunca se expone al navegador.
LASTFM_API_KEY=
