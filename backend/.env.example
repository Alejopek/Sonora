YTMUSIC_AUTH=
FRONTEND_ORIGIN=http://localhost:5173
# PostgreSQL is required for accounts, playlists, history and favorites.
DATABASE_URL=postgresql://sonora:change_me@localhost:5432/sonora
# Use a long random value in every non-local environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_HOURS=168
# Opcionales. Habilitan Last.fm OAuth; las credenciales nunca se exponen al navegador.
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Si se omite, usa la URL pública desde la que llegó la solicitud.
# LASTFM_CALLBACK_URL=https://sonora.example.com/api/lastfm/callback
